# Copiar como .env en la raíz del repositorio (el .env NUNCA se sube al repo).

# ── PostgreSQL de Odoo ───────────────────────────────────────
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=

# ── Publicación de la API para ArcGIS Online (README, sección 17) ──
# cloudflare = túnel rápido, sin cuenta; la URL cambia en cada reinicio.
# ngrok      = dominio fijo; requiere NGROK_AUTHTOKEN y NGROK_DOMAIN.
# Vacío      = sin túnel (ArcGIS Enterprise con IIS o Nginx).
COMPOSE_PROFILES=cloudflare

NGROK_AUTHTOKEN=
NGROK_DOMAIN=
