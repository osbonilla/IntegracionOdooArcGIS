# Copiar como .env dentro de integration-api/ y ajustar valores reales.
# NUNCA commitear el .env real a git.

# ── Odoo (XML-RPC) ───────────────────────────────────────────
# Desde dentro de docker-compose, el host de Odoo es "odoo" (nombre del servicio)
ODOO_URL=http://odoo:8069
ODOO_DB=odoo_demo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
# Tag (res.partner.category) usada para marcar qué contactos se sincronizan
ODOO_SYNC_TAG=Solicitud Ciudadana

# ── ArcGIS (AGOL o Enterprise) ───────────────────────────────
# AGOL:       https://www.arcgis.com
# Enterprise: https://<host>/portal   (o la URL de tu Web Adaptor de Portal)
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=tu_usuario
ARCGIS_PASSWORD=tu_password
# Item ID de la Hosted Feature Layer creada con scripts/create_arcgis_feature_layer.py
ARCGIS_FEATURE_LAYER_ITEM_ID=

# ── Sincronización ───────────────────────────────────────────
# Minutos entre sincronizaciones automáticas. 0 = desactivada (solo manual vía API)
SYNC_INTERVAL_MINUTES=0
