# Copiar como .env dentro de integration-api/

# ── Odoo (XML-RPC) ───────────────────────────────────────────
ODOO_URL=http://odoo:8069
ODOO_DB=odoo_demo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
ODOO_PROJECT_NAME=Solicitudes Ciudadanas

# ── ArcGIS (AGOL o Enterprise) ───────────────────────────────
ARCGIS_URL=https://www.arcgis.com
# True en producción / AGOL. False solo si el Enterprise usa un
# certificado autofirmado (labs/entrenamiento) — ver README sección 8.
ARCGIS_VERIFY_CERT=True

# Opción A — autenticación de usuario (cuentas SIN MFA, o Enterprise
# con autenticación básica habilitada):
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Opción B — App Authentication / OAuth client credentials (recomendado
# para AGOL con MFA: no requiere login interactivo, por lo tanto MFA no
# aplica). Si se completan estas dos variables, tienen prioridad sobre
# ARCGIS_USERNAME/ARCGIS_PASSWORD. Ver README sección 5.3.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# Item ID de la Hosted Feature Layer (ver README sección 5.2 para cómo
# obtenerlo, tanto por script como por publicación manual)
ARCGIS_FEATURE_LAYER_ITEM_ID=

# ── Sincronización ───────────────────────────────────────────
# Minutos entre sincronizaciones automáticas en AMBAS direcciones
# (Odoo->ArcGIS y ArcGIS->Odoo). 0 = desactivada (solo manual vía API).
SYNC_INTERVAL_MINUTES=0
