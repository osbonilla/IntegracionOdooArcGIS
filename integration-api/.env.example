# Copiar como .env dentro de integration-api/  (el .env NUNCA se sube al repo)

# ── Odoo (XML-RPC) ───────────────────────────────────────────
ODOO_URL=http://odoo:8069
ODOO_DB=odoo_demo
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_PROJECT_NAME=Solicitudes Ciudadanas
ODOO_WORKFRONT_PROJECT_NAME=Frentes de Trabajo

# ── ArcGIS (AGOL o Enterprise) ───────────────────────────────
ARCGIS_URL=https://www.arcgis.com
# False solo si el Enterprise usa un certificado autofirmado (laboratorio).
ARCGIS_VERIFY_CERT=True

# Opción A — usuario y contraseña (cuentas SIN MFA, o Enterprise):
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Opción B — App Authentication (recomendada para AGOL con MFA).
# Si se completan, tienen prioridad sobre usuario/contraseña.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# Items de ArcGIS (el id está en la URL del item: ...item.html?id=<ID>)
ARCGIS_FEATURE_LAYER_ITEM_ID=          # capa de solicitudes (puntos)
ARCGIS_WORKFRONT_LAYER_ITEM_ID=        # capa Frentes de Trabajo (líneas); vacío = sin frentes
ARCGIS_WEBMAP_ID=                      # mapa de Field Maps; da los enlaces "Ver en el mapa" en Odoo

# ── Webhooks (opcional, recomendado si la API se expone con el túnel) ──
# Generar claves con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARCGIS_WEBHOOK_SECRET=
INTEGRATION_API_KEY=
WEBHOOK_DEBOUNCE_SECONDS=3
WEBHOOK_RECHECK_SECONDS=10,30,60

# ── Frentes de trabajo ───────────────────────────────────────
WORKFRONT_BUFFER_M=50                  # distancia máxima solicitud-frente (m)

# ── Autoría en Odoo (opcional) ───────────────────────────────
# Solo para enlazar usuarios de ArcGIS con usuarios de Odoo de otro nombre:
# ARCGIS_ODOO_USERS=usuario_arcgis=correo_o_login_odoo, otro=otro@muni.gob.ec
ARCGIS_ODOO_USERS=

# ── Sincronización ───────────────────────────────────────────
# Pasada completa periódica (red de seguridad de los webhooks). 0 = desactivada.
SYNC_INTERVAL_MINUTES=1
